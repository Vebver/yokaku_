// Auto-generated DBML - paste into dbdiagram.io

Table announcements {
  "announcement_id" integer [pk, increment]
  "title" varchar(180) [not null]
  "description" text [not null]
  "announcement_type" varchar(30) [not null, default: `update`]
  "image_url" varchar(2048)
  "local_path" varchar(2048)
  "is_published" boolean [not null, default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table audit_logs {
  "log_id" integer [pk, increment]
  "user_id" integer
  "action" varchar(50) [not null]
  "target_id" varchar(20)
  "details" text
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]
}

Table barangays {
  "brgy_code" varchar(20) [pk]
  "brgy_name" varchar(30) [not null]
  "muni_code" varchar(20)
}

Table blocked_dates {
  "id" integer [pk, increment]
  "block_date" date [unique, not null]
  "reason" varchar(50)
}

Table categories {
  "category_id" integer [pk, increment]
  "category_name" varchar(30) [not null]
  "description" varchar(100)
}

Table event_takeout_items {
  "takeout_item_id" integer [pk, increment]
  "takeout_id" integer [not null]
  "menu_item_id" integer [not null]
  "quantity" integer [not null]
  "unit_price" decimal(10,2) [not null, default: 0.00]
}

Table event_takeout_requests {
  "takeout_id" integer [pk, increment]
  "reservation_id" varchar(20) [not null]
  "quantity" integer [not null]
  "status" varchar(24) [not null, default: `requested`]
  "requested_by" integer
  "requested_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "completed_at" timestamp
  "request_key" varchar(80)
}

Table inventory {
  "inventory_id" integer [pk, increment]
  "item_name" varchar(30)
  "category" varchar(50)
  "quantity" decimal(10,2)
  "unit" varchar(20)
  "unit_price" decimal(10,2)
  "expiry_date" date
  "supplier" varchar(20)
  "storage_location" varchar(20)
  "reorder_level" decimal(10,2)
  "last_updated" datetime
  "status" enum("Available","Low Stock","Out of Stock","Expired") [default: `Available`]
}

Table inventory_storage_locations {
  "storage_id" integer [pk, increment]
  "storage_name" varchar(100) [unique, not null]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]
}

Table inventory_units {
  "unit_id" integer [pk, increment]
  "unit_name" varchar(50) [unique, not null]
  "unit_group" varchar(30) [default: `Other`]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]
}

Table kiosk_orders {
  "order_id" integer [pk, increment]
  "reservation_id" varchar(20) [not null]
  "item_id" integer
  "quantity" integer [not null, default: 1]
  "kitchen_status" varchar(20) [default: `pending`]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "customizations" text
  "is_refill" boolean [default: 0]
  "allergy_note" text
}

Table menu_item_creation_requests {
  "submission_key" varchar(128) [pk]
  "payload_hash" char(64) [not null]
  "item_id" integer
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table menu_item_ingredients {
  "recipe_id" integer [pk, increment]
  "item_id" integer [not null]
  "inventory_id" integer [not null]
  "quantity_required" decimal(10,2) [not null]
}

Table menu_items {
  "item_id" integer [pk, increment]
  "category_id" integer
  "menu_name" varchar(100) [not null]
  "description" text
  "price" integer [not null]
  "discount_price" decimal(10,2)
  "image_url" text
  "is_available" boolean [default: 1]
  "is_featured" boolean [default: 0]
  "local_path" text
}

Table municipalities {
  "muni_code" varchar(20) [pk]
  "muni_name" varchar(50) [not null]
}

Table notifications {
  "notification_id" integer [pk, increment]
  "user_id" integer [not null]
  "reservation_id" varchar(20)
  "title" varchar(30) [not null]
  "message" text [not null]
  "type" enum("success","promo","info","alert") [default: `info`]
  "is_read" boolean [default: 0]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "read_at" datetime
  "deleted_at" timestamp
  "deleted_by" varchar(10)
}

Table payments {
  "payment_id" integer [pk, increment]
  "reservation_id" varchar(20) [unique, not null]
  "amount" decimal(10,2) [not null]
  "payment_method" enum("Cash","GCash")
  "payment_status" enum("pending","verified","rejected","expired") [default: `pending`]
  "paid_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "total_bill" decimal(12,2) [default: 0.00]
  "rejection_reason" varchar(60)
  "rejected_at" timestamp
}

Table refund_requests {
  "refund_id" integer [pk, increment]
  "user_id" integer
  "reservation_id" varchar(50)
  "subject" varchar(100)
  "comment" text
  "email" varchar(50)
  "reason" varchar(50)
  "reservation_type" varchar(50)
  "status" enum("pending","approved","rejected") [default: `pending`]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [default: `CURRENT_TIMESTAMP`]
  "refund_amount" decimal(10,2)
}

Table reservation_tables {
  "reservation_id" varchar(20) [pk]
  "table_id" integer [pk]
  "customer_name" varchar(50)
  "status" enum("pending","confirmed","seated","completed","cancelled") [default: `pending`]
  "check_in_time" datetime
  "kiosk_mode" enum("default","unlimited_wings_a","unlimited_wings_b","unlimited_wings_c") [default: `default`]
}

Table reservations {
  "reservation_id" varchar(20) [pk]
  "user_id" integer
  "first_name" varchar(20) [not null]
  "last_name" varchar(20)
  "email" varchar(50)
  "phone" varchar(11)
  "reservation_date" date [not null]
  "reservation_time" time [not null]
  "end_time" varchar(20)
  "duration_hours" decimal(5,2) [default: 1.00]
  "num_guests" integer [default: 1]
  "package_name" varchar(50)
  "status" enum("Pending","Confirmed","Seated","Completed","Cancelled","Rejected") [not null, default: `Pending`]
  "receipt_path" varchar(110)
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
  "brgy_code" varchar(10)
  "allergy" text
  "allergy_count" integer [default: 0]
  "expires_at" datetime
  "occasion" varchar(20)
  "cancellation_reason" text
  "cancelled_at" datetime
  "downpayment_amount" decimal(10,2) [default: 0.00]
  "is_kiosk_active" integer [default: 0]
  "reservation_type" varchar(20) [default: `per_table`]
}

Table reviews {
  "review_id" integer [pk, increment]
  "user_id" integer [not null]
  "rating" integer [not null]
  "comment" text [not null]
  "created_at" timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table system_settings {
  "id" integer [pk, increment]
  "setting_key" varchar(20) [unique, not null]
  "setting_value" text [not null]
}

Table tables {
  "table_id" integer [pk, increment]
  "table_number" varchar(10) [not null]
  "capacity" integer
  "available_seats" integer
  "status" varchar(10) [not null]
}

Table users {
  "user_id" integer [pk, increment]
  "first_name" varchar(50)
  "last_name" varchar(50)
  "email" varchar(50)
  "password_hash" varchar(128)
  "role" enum("admin","customer","cashier","cook") [not null, default: `customer`]
  "created_at" datetime [default: `CURRENT_TIMESTAMP`]
  "reset_password_token" varchar(50)
  "reset_password_expires" integer
  "cancellation_count" integer [default: 0]
  "last_cancellation_time" timestamp
}

